#!/usr/bin/env bash
# Opens a directory's tmux session, from a shell: the one given, else the one
# picked with fzf from what agent-mux offers. agent-mux switches to the
# session, restores it, or makes it, and ranks the directories by visits.
# Inside tmux, `prefix f` runs the same finder in agent-mux itself.
set -euo pipefail

if [[ $# -eq 1 ]]; then
    exec agent-mux open "$1"
fi

dir=$(agent-mux find --print | fzf --scheme=path --tiebreak=index) || exit 0
exec agent-mux open "$dir"
